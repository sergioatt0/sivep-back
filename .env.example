# .env.example — plantilla para .env.development.local
#
# Copiar a .env.development.local y ajustar los valores:
#   cp .env.example .env.development.local

# Entorno
NODE_ENV=development
PORT=5001

# Orígenes permitidos por CORS (separados por coma, sin espacios)
ALLOWED_ORIGINS=http://localhost:3000

# Base URL del API SISDEP (sin slash final).
# En producción, si no se define, el código usa https://www.medellin.gov.co/sisdep/back.
SISDEP_BASE_URL=https://sisdep.innovacion.it.com/sisdep/back

# Orígenes permitidos por el proxy de imágenes (separados por coma, sin slash final).
# Si no se define, por defecto se permiten https://www.medellin.gov.co y https://medellin.gov.co.
# En desarrollo local, agrega el origen del SISDEP local, p.ej. http://127.0.0.1:9000
IMAGE_ALLOWED_ORIGINS=https://www.medellin.gov.co,https://medellin.gov.co
